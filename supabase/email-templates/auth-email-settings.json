{
  "mailer_subjects_confirmation": "Welcome to Ovrendi — confirm your email",
  "mailer_templates_confirmation_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Welcome to Ovrendi</title></head><body style=\"margin:0;padding:0;background:#F3F6F9;font-family:Arial,Helvetica,sans-serif;color:#101820\"><div style=\"display:none;max-height:0;overflow:hidden\">Welcome to Ovrendi — Connected software. Smarter business.</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:16px;border-top:5px solid #D9042B\"><tr><td style=\"padding:32px 28px\"><p style=\"font-size:27px;font-weight:800;letter-spacing:-1px;margin:0 0 8px\">O<span style=\"color:#D9042B\">v</span>rendi<span style=\"color:#00A9C4\">.</span></p><p style=\"font-size:12px;color:#52606D;margin:0 0 32px\">Connected software. Smarter business.</p><h1 style=\"font-size:25px;line-height:1.25;letter-spacing:-.5px\">Welcome to Ovrendi</h1><p style=\"font-size:16px;line-height:1.7;color:#52606D\">Confirm your email to finish setting up your workspace. Your 14-day trial gives you access to the available ERP tools. Start with your company profile, add your machines and rates, then create your first quote.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#D9042B\" style=\"border-radius:8px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 24px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none\">Confirm my email</a></td></tr></table><p style=\"font-size:12px;color:#52606D;line-height:1.6;margin-top:24px\">Button not working? Copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#B50322;word-break:break-all\">{{ .ConfirmationURL }}</a></p><p style=\"font-size:13px;line-height:1.7;color:#52606D\">If you did not request this, you can ignore this email.</p><p style=\"border-top:2px solid #00C8E8;padding-top:20px;margin-top:28px;font-size:12px;line-height:1.7;color:#52606D\">Need help? <a href=\"mailto:info@ovrendi.com\" style=\"color:#B50322\">info@ovrendi.com</a><br>This is an account service email from Ovrendi.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_recovery": "Reset your Ovrendi password",
  "mailer_templates_recovery_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Let’s get you back in</title></head><body style=\"margin:0;padding:0;background:#F3F6F9;font-family:Arial,Helvetica,sans-serif;color:#101820\"><div style=\"display:none;max-height:0;overflow:hidden\">Let’s get you back in — Connected software. Smarter business.</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:16px;border-top:5px solid #D9042B\"><tr><td style=\"padding:32px 28px\"><p style=\"font-size:27px;font-weight:800;letter-spacing:-1px;margin:0 0 8px\">O<span style=\"color:#D9042B\">v</span>rendi<span style=\"color:#00A9C4\">.</span></p><p style=\"font-size:12px;color:#52606D;margin:0 0 32px\">Connected software. Smarter business.</p><h1 style=\"font-size:25px;line-height:1.25;letter-spacing:-.5px\">Let’s get you back in</h1><p style=\"font-size:16px;line-height:1.7;color:#52606D\">We received a request to reset your password. Use the secure link below to choose a new one. This link can only be used once; request another if it has expired.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#D9042B\" style=\"border-radius:8px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 24px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none\">Reset my password</a></td></tr></table><p style=\"font-size:12px;color:#52606D;line-height:1.6;margin-top:24px\">Button not working? Copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#B50322;word-break:break-all\">{{ .ConfirmationURL }}</a></p><p style=\"font-size:13px;line-height:1.7;color:#52606D\">If you did not request this, you can ignore this email.</p><p style=\"border-top:2px solid #00C8E8;padding-top:20px;margin-top:28px;font-size:12px;line-height:1.7;color:#52606D\">Need help? <a href=\"mailto:info@ovrendi.com\" style=\"color:#B50322\">info@ovrendi.com</a><br>This is an account service email from Ovrendi.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_invite": "You’re invited to Ovrendi",
  "mailer_templates_invite_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your workspace is waiting</title></head><body style=\"margin:0;padding:0;background:#F3F6F9;font-family:Arial,Helvetica,sans-serif;color:#101820\"><div style=\"display:none;max-height:0;overflow:hidden\">Your workspace is waiting — Connected software. Smarter business.</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:16px;border-top:5px solid #D9042B\"><tr><td style=\"padding:32px 28px\"><p style=\"font-size:27px;font-weight:800;letter-spacing:-1px;margin:0 0 8px\">O<span style=\"color:#D9042B\">v</span>rendi<span style=\"color:#00A9C4\">.</span></p><p style=\"font-size:12px;color:#52606D;margin:0 0 32px\">Connected software. Smarter business.</p><h1 style=\"font-size:25px;line-height:1.25;letter-spacing:-.5px\">Your workspace is waiting</h1><p style=\"font-size:16px;line-height:1.7;color:#52606D\">You have been invited to create an Ovrendi login. Use the secure link below to continue. Access to a company workspace is managed separately by its administrator.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#D9042B\" style=\"border-radius:8px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 24px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none\">Accept invitation</a></td></tr></table><p style=\"font-size:12px;color:#52606D;line-height:1.6;margin-top:24px\">Button not working? Copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#B50322;word-break:break-all\">{{ .ConfirmationURL }}</a></p><p style=\"font-size:13px;line-height:1.7;color:#52606D\">If you did not request this, you can ignore this email.</p><p style=\"border-top:2px solid #00C8E8;padding-top:20px;margin-top:28px;font-size:12px;line-height:1.7;color:#52606D\">Need help? <a href=\"mailto:info@ovrendi.com\" style=\"color:#B50322\">info@ovrendi.com</a><br>This is an account service email from Ovrendi.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_magic_link": "Your Ovrendi sign-in link",
  "mailer_templates_magic_link_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Sign in securely</title></head><body style=\"margin:0;padding:0;background:#F3F6F9;font-family:Arial,Helvetica,sans-serif;color:#101820\"><div style=\"display:none;max-height:0;overflow:hidden\">Sign in securely — Connected software. Smarter business.</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:16px;border-top:5px solid #D9042B\"><tr><td style=\"padding:32px 28px\"><p style=\"font-size:27px;font-weight:800;letter-spacing:-1px;margin:0 0 8px\">O<span style=\"color:#D9042B\">v</span>rendi<span style=\"color:#00A9C4\">.</span></p><p style=\"font-size:12px;color:#52606D;margin:0 0 32px\">Connected software. Smarter business.</p><h1 style=\"font-size:25px;line-height:1.25;letter-spacing:-.5px\">Sign in securely</h1><p style=\"font-size:16px;line-height:1.7;color:#52606D\">Use this one-time link to sign in to your Ovrendi account. Do not forward this email or share the link.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#D9042B\" style=\"border-radius:8px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 24px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none\">Sign in to Ovrendi</a></td></tr></table><p style=\"font-size:12px;color:#52606D;line-height:1.6;margin-top:24px\">Button not working? Copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#B50322;word-break:break-all\">{{ .ConfirmationURL }}</a></p><p style=\"font-size:13px;line-height:1.7;color:#52606D\">If you did not request this, you can ignore this email.</p><p style=\"border-top:2px solid #00C8E8;padding-top:20px;margin-top:28px;font-size:12px;line-height:1.7;color:#52606D\">Need help? <a href=\"mailto:info@ovrendi.com\" style=\"color:#B50322\">info@ovrendi.com</a><br>This is an account service email from Ovrendi.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_email_change": "Confirm your Ovrendi email change",
  "mailer_templates_email_change_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirm your email change</title></head><body style=\"margin:0;padding:0;background:#F3F6F9;font-family:Arial,Helvetica,sans-serif;color:#101820\"><div style=\"display:none;max-height:0;overflow:hidden\">Confirm your email change — Connected software. Smarter business.</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:16px;border-top:5px solid #D9042B\"><tr><td style=\"padding:32px 28px\"><p style=\"font-size:27px;font-weight:800;letter-spacing:-1px;margin:0 0 8px\">O<span style=\"color:#D9042B\">v</span>rendi<span style=\"color:#00A9C4\">.</span></p><p style=\"font-size:12px;color:#52606D;margin:0 0 32px\">Connected software. Smarter business.</p><h1 style=\"font-size:25px;line-height:1.25;letter-spacing:-.5px\">Confirm your email change</h1><p style=\"font-size:16px;line-height:1.7;color:#52606D\">A change to your account email was requested. Confirm the change using the secure link below.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#D9042B\" style=\"border-radius:8px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 24px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none\">Confirm email change</a></td></tr></table><p style=\"font-size:12px;color:#52606D;line-height:1.6;margin-top:24px\">Button not working? Copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#B50322;word-break:break-all\">{{ .ConfirmationURL }}</a></p><p style=\"font-size:13px;line-height:1.7;color:#52606D\">If you did not request this, you can ignore this email.</p><p style=\"border-top:2px solid #00C8E8;padding-top:20px;margin-top:28px;font-size:12px;line-height:1.7;color:#52606D\">Need help? <a href=\"mailto:info@ovrendi.com\" style=\"color:#B50322\">info@ovrendi.com</a><br>This is an account service email from Ovrendi.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_reauthentication": "Your Ovrendi verification code",
  "mailer_templates_reauthentication_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirm it’s you</title></head><body style=\"margin:0;padding:0;background:#F3F6F9;font-family:Arial,Helvetica,sans-serif;color:#101820\"><div style=\"display:none;max-height:0;overflow:hidden\">Confirm it’s you — Connected software. Smarter business.</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:16px;border-top:5px solid #D9042B\"><tr><td style=\"padding:32px 28px\"><p style=\"font-size:27px;font-weight:800;letter-spacing:-1px;margin:0 0 8px\">O<span style=\"color:#D9042B\">v</span>rendi<span style=\"color:#00A9C4\">.</span></p><p style=\"font-size:12px;color:#52606D;margin:0 0 32px\">Connected software. Smarter business.</p><h1 style=\"font-size:25px;line-height:1.25;letter-spacing:-.5px\">Confirm it’s you</h1><p style=\"font-size:16px;line-height:1.7;color:#52606D\">Use this code to continue: <strong style=\"font-size:28px;letter-spacing:5px\">{{ .Token }}</strong>. Do not share this code.</p><p style=\"font-size:13px;line-height:1.7;color:#52606D\">If you did not request this, you can ignore this email.</p><p style=\"border-top:2px solid #00C8E8;padding-top:20px;margin-top:28px;font-size:12px;line-height:1.7;color:#52606D\">Need help? <a href=\"mailto:info@ovrendi.com\" style=\"color:#B50322\">info@ovrendi.com</a><br>This is an account service email from Ovrendi.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_password_changed_notification": "Your Ovrendi password changed",
  "mailer_templates_password_changed_notification_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your password was changed</title></head><body style=\"margin:0;padding:0;background:#F3F6F9;font-family:Arial,Helvetica,sans-serif;color:#101820\"><div style=\"display:none;max-height:0;overflow:hidden\">Your password was changed — Connected software. Smarter business.</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:16px;border-top:5px solid #D9042B\"><tr><td style=\"padding:32px 28px\"><p style=\"font-size:27px;font-weight:800;letter-spacing:-1px;margin:0 0 8px\">O<span style=\"color:#D9042B\">v</span>rendi<span style=\"color:#00A9C4\">.</span></p><p style=\"font-size:12px;color:#52606D;margin:0 0 32px\">Connected software. Smarter business.</p><h1 style=\"font-size:25px;line-height:1.25;letter-spacing:-.5px\">Your password was changed</h1><p style=\"font-size:16px;line-height:1.7;color:#52606D\">The password for your account was changed. If you did not make this change, request a password reset and contact support immediately.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#D9042B\" style=\"border-radius:8px\"><a href=\"https://axon-ai-website-three.vercel.app/app/forgot-password.html\" style=\"display:inline-block;padding:16px 24px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none\">Get account help</a></td></tr></table><p style=\"font-size:12px;color:#52606D;line-height:1.6;margin-top:24px\">Button not working? Copy this link into your browser:<br><a href=\"https://axon-ai-website-three.vercel.app/app/forgot-password.html\" style=\"color:#B50322;word-break:break-all\">https://axon-ai-website-three.vercel.app/app/forgot-password.html</a></p><p style=\"font-size:13px;line-height:1.7;color:#52606D\">Keep your password private and use a unique password for Ovrendi.</p><p style=\"border-top:2px solid #00C8E8;padding-top:20px;margin-top:28px;font-size:12px;line-height:1.7;color:#52606D\">Need help? <a href=\"mailto:info@ovrendi.com\" style=\"color:#B50322\">info@ovrendi.com</a><br>This is an account service email from Ovrendi.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_email_changed_notification": "Your Ovrendi email changed",
  "mailer_templates_email_changed_notification_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your email address was changed</title></head><body style=\"margin:0;padding:0;background:#F3F6F9;font-family:Arial,Helvetica,sans-serif;color:#101820\"><div style=\"display:none;max-height:0;overflow:hidden\">Your email address was changed — Connected software. Smarter business.</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:16px;border-top:5px solid #D9042B\"><tr><td style=\"padding:32px 28px\"><p style=\"font-size:27px;font-weight:800;letter-spacing:-1px;margin:0 0 8px\">O<span style=\"color:#D9042B\">v</span>rendi<span style=\"color:#00A9C4\">.</span></p><p style=\"font-size:12px;color:#52606D;margin:0 0 32px\">Connected software. Smarter business.</p><h1 style=\"font-size:25px;line-height:1.25;letter-spacing:-.5px\">Your email address was changed</h1><p style=\"font-size:16px;line-height:1.7;color:#52606D\">Your account email address was changed. If you did not make this change, contact info@ovrendi.com immediately.</p><p style=\"font-size:13px;line-height:1.7;color:#52606D\">Review your account access if this change was unexpected.</p><p style=\"border-top:2px solid #00C8E8;padding-top:20px;margin-top:28px;font-size:12px;line-height:1.7;color:#52606D\">Need help? <a href=\"mailto:info@ovrendi.com\" style=\"color:#B50322\">info@ovrendi.com</a><br>This is an account service email from Ovrendi.</p></td></tr></table></td></tr></table></body></html>",
